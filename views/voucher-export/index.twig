{% extends 'layouts/app.twig' %}
{% import 'macros/form.twig' as f %}

{% block title %}{{ __('voucher_export.title') }}{% endblock %}

{% block content %}
    <div class="col-12">
        <div class="container">
            <h1 class="mb-4">
                {{ __('voucher_export.export') }}
            </h1>
            <div class="row">
                <div class="col">
                    <form action="{{ url('/admin/vouchers/export') }}" enctype="multipart/form-data" method="post">
                        {{ csrf() }}
                        {{ f.submit(__('voucher_export.form.export')) }}
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
